---
// Recreated sitemap of vindynamics.net as laid out for the revamp.
const cols: { name: string; kids: { t: string; lead?: boolean }[] }[] = [
  { name: 'Home', kids: [
    { t: 'Hero: Explore solutions' }, { t: 'Data Factory: Explore datasets' }, { t: 'About: Discover our story' },
    { t: 'Careers: Join our team' }, { t: 'Talk to our experts form', lead: true },
  ] },
  { name: 'Robot Solutions', kids: [{ t: 'Robot' }, { t: 'Motor' }, { t: 'Hand' }] },
  { name: 'Data Factory', kids: [
    { t: 'Search and filters' }, { t: 'Dataset detail' }, { t: 'Request a sample', lead: true },
    { t: 'Custom dataset', lead: true }, { t: 'Get a quote', lead: true }, { t: 'Talk to our experts', lead: true },
  ] },
  { name: 'Careers', kids: [] },
  { name: 'News', kids: [] },
  { name: 'About us', kids: [] },
];
const label =
  'The site map: a header on every page with the menu, a Contact button fixed in the header and a VI or EN switch. Pages: Home, with sections that lead to solutions, datasets, the company story, careers and a contact form; Robot Solutions with Robot, Motor and Hand; Data Factory with search and filters, dataset detail pages and forms to request a sample, ask for a custom dataset, get a quote or talk to the experts; Careers; News; About us.';
---
<figure class="figure figure--wide sitemap">
  <div role="img" aria-label={label} class="sitemap__box">
    <div class="sitemap__header" aria-hidden="true">
      <span class="lbl lbl--sm muted">On every page</span>
      <span>Logo</span><span>Menu</span>
      <span class="sitemap__contact">Contact, fixed in the header</span>
      <span>VI / EN</span>
    </div>
    <div class="sitemap__cols" aria-hidden="true">
      {cols.map((c) => (
        <div class:list={['sitemap__col', c.kids.length === 0 && 'sitemap__col--leaf']}>
          <span class="sitemap__page">{c.name}</span>
          {c.kids.length > 0 && (
            <ul class="sitemap__kids">
              {c.kids.map((k) => <li><span class:list={['sitemap__node', k.lead && 'sitemap__node--lead']}>{k.t}</span></li>)}
            </ul>
          )}
        </div>
      ))}
    </div>
    <span class="sitemap__legend" aria-hidden="true"><span class="sitemap__swatch"></span>A place to leave details</span>
  </div>
  <figcaption class="figure__caption muted">The sitemap and navigation I laid out for the revamp, redrawn from the live site.</figcaption>
</figure>

<style>
  .sitemap { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  @media (min-width: 1100px) { .figure--wide { width: calc(100% + min(200px, 100vw - 1010px)); max-width: none; } }
  .sitemap__box {
    background: var(--color-cream); border: var(--line); border-radius: var(--radius-md);
    padding: 16px; display: flex; flex-direction: column; gap: 14px;
  }
  @media (min-width: 640px) { .sitemap__box { padding: 18px; } }
  .sitemap__header {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
    padding: 10px 12px; border: var(--line); border-radius: 10px; background: var(--color-white); font-size: 13px;
  }
  .sitemap__contact { padding: 2px 10px; border: var(--line); border-radius: 999px; background: var(--color-sun-soft); font-weight: 600; }
  .sitemap__cols { display: flex; flex-wrap: wrap; gap: 12px; }
  .sitemap__col { flex: 1.4 1 150px; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .sitemap__col--leaf { flex: 0.8 1 90px; }
  .sitemap__page { display: block; padding: 8px 10px; border: var(--line); border-radius: 8px; font-weight: 600; font-size: 14px; background: var(--color-sand); }
  .sitemap__kids { list-style: none; margin: 0 0 0 10px; padding: 0 0 0 10px; border-left: var(--line); display: flex; flex-direction: column; gap: 6px; }
  .sitemap__node { display: block; padding: 6px 10px; border: var(--line); border-radius: 8px; font-size: 13px; line-height: 1.3; background: var(--color-white); }
  .sitemap__node--lead { background: var(--color-sun-soft); }
  .sitemap__legend { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-muted); }
  .sitemap__swatch { width: 14px; height: 14px; border: var(--line); border-radius: 4px; background: var(--color-sun-soft); }
  .figure__caption { font-size: 14px; line-height: 1.5; }
</style>
