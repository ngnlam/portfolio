---
// A row of boxes joined by arrows (arrows are fine inside diagrams). The last box is highlighted.
// The whole thing is one image for screen readers: pass a full sentence as `label`.
interface Props {
  steps: string[];
  label: string;
  tone?: 'sand' | 'plain';
}
const { steps, label, tone = 'sand' } = Astro.props;
---
<div role="img" aria-label={label} class:list={['flow', `flow--${tone}`]}>
  {steps.map((s, i) => (
    <Fragment>
      {i > 0 && <span class="flow__arrow" aria-hidden="true">→</span>}
      <span class:list={['flow__step', i === steps.length - 1 && 'flow__step--last']}>{s}</span>
    </Fragment>
  ))}
</div>

<style>
  .flow { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .flow--sand { background: var(--color-sand); border: var(--line); border-radius: var(--radius-md); padding: 16px; }
  .flow__step {
    background: var(--color-white); border: var(--line); border-radius: 10px;
    padding: 8px 12px; font-size: 15px; font-weight: 500; line-height: 1.3;
  }
  .flow__step--last { background: var(--color-sun); }
  .flow__arrow { font-size: 18px; }
</style>
