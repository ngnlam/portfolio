---
// Image with an optional caption. Pass `src` + `alt` for one image, or put
// <Image /> elements in the slot to group several. `alt` is required for `src`.
// frame: none | white | sand | dark. wide: bleeds 200px into the right margin on desktop case pages.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  caption?: string;
  frame?: 'none' | 'white' | 'sand' | 'dark';
  wide?: boolean;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  imgClass?: string;
  class?: string;
}
const {
  src,
  alt,
  caption,
  frame = 'none',
  wide = false,
  widths = [480, 800, 1200],
  sizes = wide ? '(min-width: 1100px) 880px, 100vw' : '(min-width: 1100px) 680px, 100vw',
  loading = 'lazy',
  imgClass,
  class: className,
} = Astro.props;
if (src && (alt === undefined || alt === null)) {
  throw new Error('Figure: alt text is required when src is set (use alt="" only for decorative images).');
}
const usable = src ? widths.filter((w) => w <= src.width) : [];
const finalWidths = src ? (usable.length ? usable : [src.width]) : [];
---
<figure class:list={['figure', wide && 'figure--wide', className]}>
  <div class:list={['figure__frame', `figure__frame--${frame}`]}>
    {src && (
      <Image src={src} alt={alt!} widths={finalWidths} sizes={sizes} loading={loading} class:list={['figure__img', imgClass]} />
    )}
    <slot />
  </div>
  {caption && <figcaption class="figure__caption muted">{caption}</figcaption>}
</figure>

<style>
  .figure { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  @media (min-width: 1100px) {
    .figure--wide { width: calc(100% + 200px); max-width: none; }
  }
  .figure__frame { display: flex; flex-direction: column; gap: 12px; }
  .figure__frame--white, .figure__frame--sand, .figure__frame--dark {
    border: var(--line); border-radius: var(--radius-md); padding: 14px;
  }
  .figure__frame--white { background: var(--color-white); }
  .figure__frame--sand { background: var(--color-sand); }
  .figure__frame--dark { background: var(--color-graphite); }
  .figure__frame :global(img) { width: 100%; height: auto; border: var(--line); border-radius: 12px; background: var(--color-white); }
  .figure__frame--none :global(img) { border-radius: var(--radius-md); }
  .figure__caption { font-size: 14px; line-height: 1.5; }
</style>
