---
// The leo_ wordmark: "leo" outlined from Bricolage Grotesque plus a yellow cursor.
// Paths come from src/data/logo.ts (generated by scripts/logo/build-logo.py).
// Decorative by default: give the parent link the accessible name.
// The cursor blinks three times on load and three times when the parent link is hovered
// or focused (no endless loop, brand.md 8); never with reduced motion.
import { LOGO } from '../data/logo';

interface Props {
  class?: string;
  height?: number;
}
const { class: className, height = 22 } = Astro.props;
const c = LOGO.cursor;
const width = Math.round((LOGO.width / LOGO.height) * height * 10) / 10;
---
<svg
  class:list={['logo', className]}
  viewBox={LOGO.viewBox}
  width={width}
  height={height}
  aria-hidden="true"
  focusable="false"
>
  <path d={LOGO.letters} fill="currentColor" />
  <rect
    class="logo__cursor"
    x={c.x} y={c.y} width={c.w} height={c.h} rx={c.rx}
    fill="var(--color-sun, #FFC93C)" stroke="var(--color-graphite, #1F2226)" stroke-width={c.stroke}
  />
</svg>

<style>
  .logo { display: block; flex: none; overflow: visible; }
  .logo__cursor { animation: logo-blink 1s steps(1, end) 0.4s 3; }
  :global(a:hover) .logo__cursor,
  :global(a:focus-visible) .logo__cursor { animation: logo-blink-again 1s steps(1, end) 3; }
  /* Two names so hovering restarts the animation after the load blinks have finished. */
  @keyframes logo-blink { 50% { opacity: 0; } }
  @keyframes logo-blink-again { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .logo__cursor, :global(a:hover) .logo__cursor, :global(a:focus-visible) .logo__cursor { animation: none; }
  }
</style>
