---
// Photo in a white frame with a hard shadow, tilted between -2 and 2 degrees.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  rotate?: number;
  aspect?: string;
  maxWidth?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
}
const {
  src, alt, caption,
  rotate = 2,
  aspect = '1 / 1',
  maxWidth = '320px',
  widths = [320, 480, 720],
  sizes = '(min-width: 900px) 420px, 80vw',
  class: className,
} = Astro.props;
const usable = widths.filter((w) => w <= src.width);
---
<figure class:list={['polaroid', className]} style={`--rot:${rotate}deg;--maxw:${maxWidth}`}>
  <Image src={src} alt={alt} widths={usable.length ? usable : [src.width]} sizes={sizes} style={`aspect-ratio:${aspect}`} />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .polaroid { transform: rotate(var(--rot)); width: 100%; max-width: var(--maxw); }
</style>
