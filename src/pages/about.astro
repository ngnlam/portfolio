---
// About = the CV, written for the web. Facts come from src/data/cv.ts, which also feeds the PDF (/cv).
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CvJob from '../components/CvJob.astro';
import Icon from '../components/Icon.astro';
import Portrait from '../components/Portrait.astro';
import Polaroid from '../components/Polaroid.astro';
import quotesData from '../data/quotes.json';
import { CV, CV_PDF, chipCase } from '../data/cv';
import { LOGOS } from '../data/logos';
import teamPhoto from '../assets/images/about/team-xanhsm.jpg';
import outsidePhoto from '../assets/images/about/outside-work.jpg';

const quotes = quotesData as { text: string; who: string }[];
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---
<BaseLayout
  title="About | Leo Lam Nguyen"
  description="Growth and product specialist in Hanoi: an AI sales agent at VinFast, requirements for an AI security robot at VinDynamics, rider journeys at Xanh SM."
  current="about"
>
  <section class="container intro" aria-labelledby="about-title">
    <div class="intro__text">
      <h1 id="about-title" class="d h-display">About</h1>
      <p class="intro__lead">{CV.intro.lead}</p>
      <p class="intro__body">{CV.intro.body}</p>
      <div class="intro__actions">
        <Button href={CV_PDF} variant="secondary" event="cv_download" eventData={{ from: 'about' }}>
          <Icon name="arrowDown" size={18} /> Download the CV (PDF)
        </Button>
      </div>
    </div>
    <div class="intro__portrait">
      <Portrait maxWidth="400px" />
    </div>
  </section>

  <section class="container exp" aria-labelledby="exp-title">
    <h2 id="exp-title" class="d h-section">Experience</h2>

    <div class="grp">
      <div class="grp__head">
        <span class="grp__name">{CV.group.label}</span>
        <span class="lbl muted">{CV.group.place} | {CV.group.dates}</span>
      </div>
      <ol class="tl tl--rail" role="list">
        {CV.group.jobs.map((job) => <CvJob job={job} />)}
      </ol>
    </div>

    <div class="grp">
      <div class="grp__head">
        <span class="grp__name">Before Vingroup</span>
        <span class="lbl muted">2021 to 2024</span>
      </div>
      <ol class="tl" role="list">
        {CV.jobs.map((job) => <CvJob job={job} />)}
      </ol>
      <div class="earlier">
        <h3 class="lbl lbl--sm clay">Earlier</h3>
        <ul class="earlier__list" role="list">
          {CV.earlier.map((e) => (
            <li class="earlier__item">
              <span class="earlier__logo"><Image src={LOGOS[e.logo].src} alt="" width={96} /></span>
              <span class="earlier__text"><strong>{e.company}</strong>, {e.text}</span>
              <span class="lbl lbl--sm muted earlier__dates">{e.dates}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="container prods" aria-labelledby="prods-title">
    <h2 id="prods-title" class="d h-section">Products of my own</h2>
    <ul class="prods__grid" role="list">
      {CV.products.map((p) => (
        <li>
          <a
            href={`/work/${p.case}`}
            class="card prod"
            data-umami-event="case_card_click"
            data-umami-event-case={p.case}
            data-umami-event-from="about"
          >
            <span class="prod__mark">
              {p.logo ? <Image src={LOGOS[p.logo].src} alt="" width={160} /> : <Icon name="flow" size={26} />}
            </span>
            <span class="d prod__name">{p.name}</span>
            <span class="prod__text">{cap(p.text)}{p.web && <> {p.web}</>}</span>
            <span class="prod__more">Read the case <Icon name="arrowRight" size={16} /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="container skills" aria-labelledby="skills-title">
    <h2 id="skills-title" class="d h-section">Skills</h2>
    <dl class="skills__grid">
      {CV.skills.map((s) => (
        <div class="skills__row">
          <dt class="lbl clay">{s.group}</dt>
          <dd>
            <ul class="skills__chips" role="list">
              {s.items.map((x) => <li class="skill">{chipCase(x)}</li>)}
            </ul>
          </dd>
        </div>
      ))}
      <div class="skills__row">
        <dt class="lbl clay">Languages</dt>
        <dd class="skills__lang">{CV.languages}</dd>
      </div>
    </dl>
  </section>

  <section class="container edu" aria-labelledby="edu-title">
    <div class="edu__head">
      <h2 id="edu-title" class="d h-section">Education</h2>
      <p class="edu__aside">The data science is mostly so my opinions come with confidence intervals.</p>
    </div>
    <div class="edu__cols">
      <div class="edu__col">
        <h3 class="lbl clay">Degrees</h3>
        <ul class="edu__list" role="list">
          {CV.education.map((e) => (
            <li class="edu-item">
              <span class="edu-item__logo"><img src={e.logo} alt="" loading="lazy" decoding="async" /></span>
              <span class="edu-item__text">
                <span class="edu-item__what">{e.what}</span>
                <span class="muted">{e.where}</span>
                {e.web && <span class="muted edu-item__note">{e.web}</span>}
                <span class="lbl lbl--sm muted">{e.dates}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
      <div class="edu__col">
        <h3 class="lbl clay">Professional programs (online)</h3>
        <ul class="edu__list" role="list">
          {CV.programs.map((e) => (
            <li class="edu-item">
              <span class="edu-item__logo"><img src={e.logo} alt="" loading="lazy" decoding="async" /></span>
              <span class="edu-item__text">
                <span class="edu-item__what">{e.what}</span>
                <span class="muted">{e.where}</span>
                <span class="lbl lbl--sm muted">Completed {e.dates}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="container awards" aria-labelledby="awards-title">
    <div class="awards__text">
      <h2 id="awards-title" class="d h-section">Recognition</h2>
      <ul class="awards__list" role="list">
        {CV.awards.map((a) => (
          <li class="award">
            <span class="ic"><Icon name="award" /></span>
            <span class="award__text">
              <span class="award__title">{a.what}</span>
              <span class="muted">{a.where}, {a.year}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
    <div class="awards__photo">
      <Polaroid
        src={teamPhoto}
        alt="Leo at a Xanh SM team session, sitting with colleagues in team shirts."
        caption="Xanh SM, with the team."
        rotate={2}
        maxWidth="320px"
      />
    </div>
  </section>

  <section id="people" class="band band--sand" aria-labelledby="people-title">
    <div class="container people">
      <h2 id="people-title" class="d h-section">What colleagues say</h2>
      <ul class="people__grid" role="list">
        {quotes.map((q) => (
          <li class="quote-card">
            <figure class="quote-card__fig">
              <blockquote>
                <span class="d quote-card__mark" aria-hidden="true">&ldquo;</span>
                <p class="d quote-card__text">{q.text}</p>
              </blockquote>
              <figcaption class="lbl lbl--sm quote-card__who">{q.who}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container outside" aria-labelledby="outside-title">
    <div class="outside__photo">
      <Polaroid
        src={outsidePhoto}
        alt="Leo in a white shirt and tinted glasses by a tree-lined river, with rowing boats behind him."
        caption="Offline, for once."
        rotate={-2}
        aspect="4 / 5"
        maxWidth="420px"
      />
    </div>
    <div class="outside__text">
      <h2 id="outside-title" class="d h-section">Outside work</h2>
      <p>I read a lot about psychology and motivation, mostly to understand why people, me included, do what they do. Some of that turns into small tools in the Lab.</p>
      <div><Button href="/lab" variant="secondary" block>Visit the Lab</Button></div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Intro */
  .intro {
    padding-block: 40px 48px;
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px;
  }
  @media (min-width: 900px) {
    .intro { padding-block: 96px; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 64px; align-items: center; }
  }
  .intro__text { display: flex; flex-direction: column; gap: 20px; }
  @media (min-width: 900px) { .intro__text { gap: 28px; } }
  .intro__lead { font-size: 23px; line-height: 1.35; max-width: 620px; font-weight: 500; }
  .intro__body { font-size: 17px; line-height: 1.65; max-width: 620px; }
  @media (min-width: 900px) {
    .intro__lead { font-size: 28px; }
    .intro__body { font-size: 19px; }
  }
  .intro__actions :global(.btn) { gap: 10px; }
  .intro__portrait { display: flex; justify-content: center; }

  /* Experience */
  .exp { padding-block: 8px 56px; display: flex; flex-direction: column; gap: 20px; }
  @media (min-width: 900px) { .exp { padding-block: 24px 120px; gap: 32px; } }
  .grp {
    background: var(--color-white);
    border: var(--line); border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .grp__head {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 16px;
    padding: 14px 16px;
    background: var(--color-sand);
    border-bottom: var(--line);
  }
  @media (min-width: 640px) { .grp__head { padding: 16px 28px; } }
  .grp__name { font-weight: 600; font-size: 17px; }
  .tl { list-style: none; margin: 0; padding: 0 16px; position: relative; }
  @media (min-width: 640px) { .tl { padding: 0 28px; } }
  /* The timeline rail runs behind the logo tiles on desktop. */
  @media (min-width: 900px) {
    .tl--rail::before {
      content: ""; position: absolute; left: calc(28px + 36px); top: 64px; bottom: 64px;
      border-left: 1.5px dashed var(--border-dashed);
    }
  }
  .earlier { padding: 18px 16px 22px; border-top: 1px dashed var(--border-dashed); display: flex; flex-direction: column; gap: 12px; }
  @media (min-width: 640px) { .earlier { padding: 22px 28px 26px; } }
  @media (min-width: 900px) { .earlier { padding-left: calc(28px + 152px + 36px); } }
  .earlier__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .earlier__item { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 2px 12px; align-items: center; font-size: 16px; line-height: 1.45; }
  @media (min-width: 640px) { .earlier__item { grid-template-columns: 36px minmax(0, 1fr) auto; } }
  .earlier__logo {
    width: 36px; height: 36px; grid-row: span 2;
    display: grid; place-items: center; padding: 4px;
    border: var(--line); border-radius: 10px; background: var(--color-white);
  }
  @media (min-width: 640px) { .earlier__logo { grid-row: auto; } }
  .earlier__logo :global(img) { width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; }
  .earlier__dates { grid-column: 2; }
  @media (min-width: 640px) { .earlier__dates { grid-column: auto; white-space: nowrap; } }

  /* Products */
  .prods { padding-block: 0 56px; display: flex; flex-direction: column; gap: 20px; }
  @media (min-width: 900px) { .prods { padding-block: 0 120px; gap: 32px; } }
  .prods__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  @media (min-width: 900px) { .prods__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; } }
  .prods__grid > li { display: flex; }
  .prod {
    display: flex; flex-direction: column; gap: 12px; width: 100%;
    padding: 20px; text-decoration: none;
    background: var(--color-white); border: var(--line); border-radius: var(--radius-md);
  }
  @media (min-width: 900px) { .prod { padding: 28px; } }
  .prod__mark {
    height: 56px; width: fit-content; min-width: 56px; padding: 6px 10px;
    display: grid; place-items: center;
    border: var(--line); border-radius: 14px; background: var(--color-sun-soft);
  }
  .prod__mark :global(img) { height: 40px; width: auto; }
  .prod__name { font-size: 26px; line-height: 1.1; }
  .prod__text { font-size: 16px; line-height: 1.6; }
  @media (min-width: 900px) { .prod__text { font-size: 17px; } }
  .prod__more {
    margin-top: auto; display: inline-flex; align-items: center; gap: 6px;
    font-weight: 500; font-size: 15px;
    text-decoration: underline; text-decoration-color: var(--color-clay); text-decoration-thickness: 2px; text-underline-offset: 4px;
  }

  /* Skills */
  .skills { padding-block: 0 56px; display: flex; flex-direction: column; gap: 20px; }
  @media (min-width: 900px) { .skills { padding-block: 0 120px; gap: 32px; } }
  .skills__grid { margin: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; }
  @media (min-width: 900px) { .skills__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 48px; } }
  .skills__row { display: flex; flex-direction: column; gap: 10px; padding: 16px 0; border-top: var(--line); }
  .skills__row dd { margin: 0; }
  .skills__chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .skill {
    padding: 5px 12px; border: var(--line); border-radius: var(--radius-pill);
    background: var(--color-white); font-size: 14px; line-height: 1.35;
  }
  @media (min-width: 900px) { .skill { font-size: 15px; } }
  .skills__lang { font-size: 16px; line-height: 1.5; }

  /* Education */
  .edu { padding-block: 0 56px; display: flex; flex-direction: column; gap: 20px; }
  @media (min-width: 900px) { .edu { padding-block: 0 120px; gap: 32px; } }
  .edu__head { display: flex; flex-direction: column; gap: 12px; }
  @media (min-width: 900px) {
    .edu__head { flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 48px; }
  }
  .edu__aside { font-size: 16px; line-height: 1.55; max-width: 460px; }
  @media (min-width: 900px) { .edu__aside { font-size: 18px; } }
  .edu__cols { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }
  @media (min-width: 900px) { .edu__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px; } }
  .edu__col { display: flex; flex-direction: column; gap: 4px; }
  .edu__list { list-style: none; margin: 0; padding: 0; }
  .edu-item { display: flex; gap: 16px; padding: 16px 0; border-top: var(--line); align-items: flex-start; }
  .edu-item__logo {
    width: 104px; height: 52px; flex: 0 0 104px;
    display: block; padding: 6px 8px;
    background: var(--color-white); border: var(--line); border-radius: 12px;
  }
  @media (min-width: 900px) { .edu-item__logo { width: 140px; height: 62px; flex-basis: 140px; } }
  .edu-item__logo img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .edu-item__text { display: flex; flex-direction: column; gap: 4px; font-size: 15px; line-height: 1.5; min-width: 0; }
  .edu-item__what { font-weight: 600; font-size: 17px; line-height: 1.35; }
  .edu-item__note { font-size: 14px; }

  /* Recognition */
  .awards { padding-block: 0 56px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }
  @media (min-width: 900px) {
    .awards { padding-block: 0 120px; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 64px; align-items: center; }
  }
  .awards__text { display: flex; flex-direction: column; gap: 20px; }
  @media (min-width: 900px) { .awards__text { gap: 32px; } }
  .awards__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; }
  @media (min-width: 640px) { .awards__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; } }
  .award {
    background: var(--color-white); border: var(--line); border-radius: var(--radius-md);
    padding: 16px; display: flex; gap: 14px; align-items: flex-start;
  }
  .award__text { display: flex; flex-direction: column; gap: 4px; font-size: 15px; line-height: 1.45; }
  .award__title { font-weight: 600; font-size: 17px; line-height: 1.3; }
  .awards__photo { display: flex; justify-content: center; padding-inline: 24px; }

  /* Quotes */
  .people { padding-block: 48px; display: flex; flex-direction: column; gap: 16px; }
  @media (min-width: 900px) { .people { padding-block: 96px; gap: 40px; } }
  .people__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px;
  }
  @media (min-width: 640px) { .people__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; } }
  @media (min-width: 1100px) { .people__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; } }
  .quote-card {
    background: var(--color-white);
    border: var(--line); border-radius: 14px;
    padding: 18px;
    display: flex;
  }
  @media (min-width: 900px) { .quote-card { border-radius: var(--radius-md); padding: 24px; } }
  .quote-card__fig { margin: 0; display: flex; flex-direction: column; gap: 14px; width: 100%; }
  @media (min-width: 900px) { .quote-card__fig { gap: 18px; } }
  .quote-card__mark { display: block; font-size: 56px; line-height: 0.5; color: var(--color-clay); padding-top: 18px; }
  .quote-card__text { font-size: 20px; font-weight: 500; line-height: 1.3; }
  @media (min-width: 900px) { .quote-card__text { font-size: 22px; } }
  .quote-card__who {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px dashed var(--border-dashed);
    font-weight: 500;
  }

  /* Outside work */
  .outside {
    padding-block: 56px;
    display: flex; flex-direction: column; gap: 20px;
  }
  @media (min-width: 900px) {
    .outside { padding-block: 120px; flex-direction: row; flex-wrap: wrap; gap: 80px; align-items: center; }
    .outside__photo { flex: 0 1 420px; min-width: 0; }
    .outside__text { flex: 1 1 480px; min-width: 0; }
  }
  .outside__photo { padding-inline: 24px 24px; padding-bottom: 12px; }
  @media (min-width: 900px) { .outside__photo { padding: 0; } }
  .outside__text { display: flex; flex-direction: column; gap: 20px; }
  @media (min-width: 900px) { .outside__text { gap: 24px; } }
  .outside__text p { font-size: 17px; line-height: 1.6; max-width: 560px; }
  @media (min-width: 900px) { .outside__text p { font-size: 20px; } }
</style>
